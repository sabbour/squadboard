{
  "name": "@sabbour/squadboard-docs",
  "version": "0.1.0-prealpha.0",
  "private": true,
  "scripts": {
    "build": "node scripts/docusaurus.mjs build",
    "clear": "node scripts/docusaurus.mjs clear",
    "dev": "node scripts/docusaurus.mjs start --host 0.0.0.0 --port 3002",
    "generate:llms": "node scripts/generate-llms.mjs",
    "prebuild": "pnpm run generate:llms",
    "predev": "pnpm run generate:llms",
    "prestart": "pnpm run generate:llms",
    "serve": "node scripts/docusaurus.mjs serve --host 0.0.0.0 --port 3002",
    "start": "node scripts/docusaurus.mjs start --host 0.0.0.0 --port 3002"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "3.10.1",
    "@fluentui/react-icons": "^2.0.326",
    "@mdx-js/react": "^3.0.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
