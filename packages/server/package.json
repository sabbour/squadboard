{
  "name": "@sabbour/squadboard",
  "version": "0.1.0-prealpha.0",
  "description": "Pre-alpha local-first kanban + workflow board for Squad agents \u2014 MCP server and CLI",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "squadboard": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "coordinator-fragment.md",
    "heartbeat.config.json",
    "scripts/postinstall-coordinator-fragment.mjs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sabbour/squadboard.git"
  },
  "homepage": "https://github.com/sabbour/squadboard#readme",
  "publishConfig": {
    "access": "public",
    "tag": "prealpha"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:postgresql": "tsx watch src/cli/index.ts start --squad-storage postgresql",
    "dev:fs": "tsx watch src/cli/index.ts start --squad-storage fs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc && pnpm run build:assets",
    "build:assets": "node scripts/copy-build-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:cost-drift": "RUN_RATE_DRIFT_TEST=1 vitest run cost-rate-drift",
    "prepublishOnly": "pnpm run build",
    "postinstall": "node scripts/postinstall-coordinator-fragment.mjs",
    "migrate": "tsx src/cli/migrate.ts",
    "migrate:dry": "tsx src/cli/migrate.ts --dry-run",
    "migrate:verify": "tsx src/cli/migrate.ts --verify",
    "migrate:rollback": "tsx src/cli/migrate-rollback.ts",
    "backup": "tsx src/cli/backup.ts",
    "restore": "tsx src/cli/restore.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bradygaster/squad-sdk": "0.9.4",
    "@electric-sql/pglite": "^0.4.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sabbour/squadboard-sdk": "workspace:*",
    "@types/multer": "^2.1.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.17.1",
    "chokidar": "^3.6.0",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.36.4",
    "express": "^5.0.0",
    "jose": "^6.0.0",
    "js-yaml": "^4.1.0",
    "yaml": "^2.9.0",
    "multer": "^2.1.1",
    "pg": "^8.13.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
