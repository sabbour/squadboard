{
  "name": "@sabbour/squadboard-cli",
  "version": "0.0.1",
  "description": "Pre-alpha CLI for Squadboard \u2014 `npx @sabbour/squadboard-cli init`",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "squadboard": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sabbour/squadboard.git"
  },
  "homepage": "https://github.com/sabbour/squadboard#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
