# Dependencies and build artifacts (added 2026-05-16 — these were leaking dirty status across all packages)
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
out/
**/out/
.vite/
**/.vite/
.docusaurus/
**/.docusaurus/
*.tsbuildinfo

# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log
.squad/log
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
# Squad: allow Scribe-authored files (wave close orchestration & health reports)
!.squad/orchestration-log/*.md
!.squad/log/*.md
!.squad/health/
!.squad/health/**/*.md
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
# Phase 13: per-project AES-256-GCM secret key for MCP header encryption
.squad/.secret-key
# Runtime logs (generated by dev server and verification scripts)
.server-dev.log
.squad/server.log
.verify.log
.srv-verify.log
# Playwright test reports
packages/e2e/playwright-report/
packages/e2e/test-results/
packages/e2e/.e2e-home/
packages/e2e/.e2e-workspaces/
packages/server/.squad/db-snapshots/*.json
