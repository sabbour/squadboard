{
  "name": "@sabbour/squadboard-monorepo",
  "version": "0.1.0",
  "description": "Local-first kanban + workflow board for Squad agents",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @sabbour/squadboard --filter @sabbour/squadboard-client run dev",
    "dev:postgresql": "pnpm --parallel --filter @sabbour/squadboard --filter @sabbour/squadboard-client run dev:postgresql",
    "dev:fs": "pnpm --parallel --filter @sabbour/squadboard --filter @sabbour/squadboard-client run dev:fs",
    "docs:build": "pnpm --filter @sabbour/squadboard-docs build",
    "docs:dev": "pnpm --filter @sabbour/squadboard-docs dev",
    "docs:serve": "pnpm --filter @sabbour/squadboard-docs serve",
    "start": "pnpm --parallel --filter @sabbour/squadboard --filter @sabbour/squadboard-client --filter @sabbour/squadboard-docs run dev",
    "cli:start": "pnpm --filter @sabbour/squadboard-cli start",
    "test:e2e": "pnpm --filter @sabbour/squadboard-e2e test",
    "electron:dev": "pnpm --filter @sabbour/squadboard-electron dev",
    "electron:build": "pnpm --filter @sabbour/squadboard-electron build"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
