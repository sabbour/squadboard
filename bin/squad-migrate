#!/usr/bin/env bash
# bin/squad-migrate — Wave 14 legacy-PG → PGlite one-time data migrator
#
# Recovers data from the embedded-postgres era (before Wave 13) and loads it
# into the new PGlite cluster at ~/.squadboard/data/pglite/.
#
# Usage:
#   squad-migrate                    — run migration (no-op if already done)
#   squad-migrate --dry-run          — report row counts, no writes
#   squad-migrate --force --yes      — re-run even if marker exists, no prompt
#   squad-migrate --verbose          — extra diagnostic output
#   squad-migrate --help             — show usage
#
# Migration is idempotent. Once the marker file
# ~/.squadboard/data/.migrated-to-pglite-v1 is written, subsequent runs
# are no-ops unless --force is passed.
#
# The legacy data directory is READ-ONLY — this script never modifies it.
# After verifying the migration, you may safely delete ~/.squadboard/data/
# (keep ~/.squadboard/data/pglite/ — that is your live database).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

exec npx --yes tsx "$REPO_ROOT/packages/server/src/cli/migrate.ts" "$@"
