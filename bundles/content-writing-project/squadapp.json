{
  "$schema": "https://squadboard.dev/schemas/squadapp/v1/squadapp.json",
  "schemaVersion": 1,
  "appId": "content-writing-project",
  "version": "1.1.0",
  "name": "Content Creation",
  "displayName": "Content Creation",
  "description": "Lightweight content workflow for ideas, drafting, review, and publishing with one writer and one editor.",
  "kind": "project-template",
  "author": "Squadboard team",
  "license": "MIT",
  "homepage": "https://github.com/sabbour/squadboard",
  "tags": [
    "content",
    "writing",
    "editorial"
  ],
  "requires": {
    "squadboard": ">=0.1.0"
  },
  "project": {
    "name": "Content Creation",
    "description": "A lightweight pipeline for articles, posts, scripts, newsletters, or announcements.",
    "icon": "✍️"
  },
  "kanban": {
    "columns": [
      {
        "slug": "ideas",
        "label": "Ideas",
        "order": 0
      },
      {
        "slug": "drafting",
        "label": "Drafting",
        "order": 1,
        "wip_limit": 3
      },
      {
        "slug": "review",
        "label": "Review",
        "order": 2
      },
      {
        "slug": "published",
        "label": "Published",
        "order": 3
      }
    ],
    "defaultColumn": "ideas"
  },
  "team": [
    {
      "name": "Writer",
      "role": "Writer",
      "persistent": true,
      "charterPath": "agents/Writer/charter.md"
    },
    {
      "name": "Editor",
      "role": "Editor",
      "persistent": true,
      "charterPath": "agents/Editor/charter.md"
    }
  ],
  "ceremonies": [
    {
      "id": "draft-review",
      "name": "Draft Review",
      "scope": "task",
      "trigger": {
        "kind": "on_issue_entry",
        "config": {
          "column": "review"
        }
      },
      "workflowPath": "ceremonies/draft-review.yaml"
    },
    {
      "id": "publish-checklist",
      "name": "Publish Checklist",
      "scope": "task",
      "trigger": {
        "kind": "manual"
      },
      "workflowPath": "ceremonies/publish-checklist.yaml"
    }
  ],
  "skills": [
    {
      "key": "tone-check",
      "name": "Tone Check",
      "description": "A lightweight audience, clarity, and readability check for content drafts.",
      "category": "content"
    }
  ],
  "routing": [
    {
      "label": "idea",
      "agent": "Writer"
    },
    {
      "label": "draft",
      "agent": "Writer"
    },
    {
      "label": "review",
      "agent": "Editor"
    }
  ],
  "artifacts": {
    "agents": [
      "agents/Writer/charter.md",
      "agents/Editor/charter.md"
    ],
    "ceremonies": [
      "ceremonies/draft-review.yaml",
      "ceremonies/publish-checklist.yaml"
    ],
    "skills": [
      "skills/tone-check/SKILL.md"
    ]
  }
}
